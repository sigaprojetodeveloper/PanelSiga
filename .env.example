# ==========================================
# SIGA PANEL ADMIN - ENVIRONMENT TEMPLATE
# ==========================================
# Copie este arquivo para .env.local ou utilize:
#   npm run env:dev   -> para apontar para Desenvolvimento
#   npm run env:prod  -> para apontar para Produção
# ==========================================

# URL do Projeto Supabase
SIGA_SUPABASE_URL=https://your-project-id.supabase.co

# Chave Pública Anônima (Client-Side Safe)
SIGA_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Ambiente de Armazenamento R2 (develop | production)
SIGA_STORAGE_ENV=develop

# [OPCIONAL / APENAS SERVER-SIDE] Chave de Serviço Administrativa
# NUNCA expor no cliente ou no next.config.ts!
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
